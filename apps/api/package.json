{
  "name": "@kite/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=../../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file=../../.env src/seed/index.ts",
    "db:reset": "tsx --env-file=../../.env src/db/reset.ts",
    "db:push-reset": "tsx src/db/push-reset.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.3.0",
    "@kite/shared": "workspace:*",
    "drizzle-orm": "^0.44.7",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.8",
    "nodemailer": "^6.10.1",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.16.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "unpdf": "^0.12.2",
    "uuid": "^11.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^6.4.24",
    "@types/pdfkit": "^0.13.9",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.11",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "vitest": "^3.2.7"
  }
}
