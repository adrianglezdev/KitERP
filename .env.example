# Base de datos (docker compose up -d db)
DATABASE_URL=postgres://kite:kite_dev_password@localhost:5433/kite
DB_USER=kite
DB_PASSWORD=kite_dev_password
DB_NAME=kite
DB_PORT=5433

# API
API_PORT=4000
APP_URL=http://localhost:5173
SESSION_SECRET=cambia-esto-por-una-cadena-larga-aleatoria
STORAGE_DIR=./storage

# Correo saliente (si no se configura, los emails se guardan en la bandeja de salida interna)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="KiteERP <no-responder@example.com>"

# Verifactu: entorno de pruebas de la AEAT mientras no se configure el certificado
VERIFACTU_ENTORNO=pruebas
